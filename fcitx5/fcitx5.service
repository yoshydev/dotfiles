# fcitx5 を systemd ユーザーサービスとして起動する (WSL + WSLg 用)。
#
# 背景: 以前は zsh(linux.zsh) と wezterm のフックがそれぞれ fcitx5 を起動していたが、
# PC 再起動後の初回起動時に二重起動が競合し、「wezterm が接続した直後の fcitx5 を
# フックの -r が kill する」レースで wezterm 側の XIM クライアント (xcb-imdkit) の
# リクエストキューが恒久的に詰まり、IME が効かなくなっていた。
# 起動経路をこのサービスに一本化することでレース自体を排除する。
#
# 配置: install.sh が ~/.config/systemd/user/ へシンボリックリンクし、
#       systemctl --user enable --now fcitx5.service で有効化する。

[Unit]
Description=Fcitx5 input method (X11/XIM for WSLg)

[Service]
Type=exec
# WSLg の XWayland に接続する。wayland アドオンは WSLg では即死するため無効化し、
# X11(XIM) 経由で動かす (wezterm 側は enable_wayland=false)。
Environment=DISPLAY=:0
ExecStart=/usr/bin/fcitx5 --disable=wayland
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
