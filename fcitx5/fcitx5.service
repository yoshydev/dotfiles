# fcitx5 を systemd ユーザーサービスとして起動する (WSL + WSLg 用)。
# 起動経路はこのサービスに一本化 (シェルや wezterm フックからは起動しない)。
# install.sh が ~/.config/systemd/user/ に symlink し enable する。

[Unit]
Description=Fcitx5 input method (X11/XIM for WSLg)

[Service]
Type=exec
# WSLg では wayland アドオンが表示接続を維持できず即死するため、
# X11 (XIM) 経由で動かす (wezterm 側は enable_wayland=false)。
Environment=DISPLAY=:0
ExecStart=/usr/bin/fcitx5 --disable=wayland
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
